{
  "name": "composite-js",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "description": "A JavaScript grammar for building composite visualizations in the browser.",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./umd": "./dist/umd/composite.umd.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node scripts/dev-example.mjs",
    "build": "vite build && vite build --config vite.export.config.js",
    "site:dev": "astro dev --root site",
    "site:build": "astro build --root site",
    "site:preview": "astro preview --root site",
    "site:export-examples": "node scripts/export-site-examples.mjs",
    "test": "node test/run.mjs",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "check": "pnpm run lint && pnpm run build && pnpm run test",
    "check:site": "pnpm run site:build",
    "format": "prettier --write ."
  },
  "keywords": [
    "visualization",
    "grammar",
    "charts",
    "d3",
    "composition"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shenzhiy21/composite.js.git"
  },
  "bugs": {
    "url": "https://github.com/shenzhiy21/composite.js/issues"
  },
  "homepage": "https://github.com/shenzhiy21/composite.js#readme",
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/view": "^6.43.0",
    "@eslint/js": "^9",
    "astro": "^6.3.6",
    "codemirror": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.7.4",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "optionalDependencies": {
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "d3": "^7.9.0"
  }
}
