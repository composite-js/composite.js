{
  "name": "composite-js",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "description": "A small JavaScript functional composition library (demo) using Vite + pnpm",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node scripts/dev-example.mjs",
    "build": "vite build",
    "site:dev": "astro dev --root site",
    "site:build": "astro build --root site",
    "site:preview": "astro preview --root site",
    "site:export-examples": "node scripts/export-site-examples.mjs",
    "test": "node test/run.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write ."
  },
  "keywords": [
    "compose",
    "functional",
    "library",
    "vite"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/view": "^6.43.0",
    "@eslint/js": "^9",
    "astro": "^6.3.6",
    "codemirror": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.7.4",
    "sharp": "^0.34.5",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "d3": "^7.9.0"
  }
}
