---
import SiteLayout from "../layouts/SiteLayout.astro";
import SectionShell from "../components/SectionShell.astro";
import ExampleGrid from "../components/ExampleGrid.astro";
import CodePanel from "../components/CodePanel.astro";
import { featuredExamples } from "../data/examples.js";

const quickStartCode = `import { chart, stackY, repeatX } from "composite-js";

const top = chart({
  mark: "bar",
  data,
  encoding: { x: "id", y: "value" },
});

const matrix = chart({
  mark: "matrix",
  data: matrixCells,
  encoding: { x: "id", group: "set", y: "active" },
});

const pies = repeatX(ids, (id) =>
  chart({
    mark: "pie",
    data: details[id],
    encoding: { x: "category", y: "value" },
  }),
);

stackY([top, matrix, pies]).render(document.querySelector("#app"));`;
---

<SiteLayout title="composite.js | Composite visualization grammar">
  <section class="hero-shell">
    <div class="site-container hero-shell__grid">
      <div class="hero-copy">
        <p class="eyebrow">composite.js</p>
        <h1>Describe charts. Compose their relationships.</h1>
        <p class="hero-copy__lead">
          Define the charts you need and how they relate. composite.js renders
          each chart and computes the concrete layout with sensible defaults.
        </p>
        <div class="hero-actions">
          <a class="button button--primary" href={`${import.meta.env.BASE_URL}docs/`}>
            Get started
          </a>
          <a class="button" href={`${import.meta.env.BASE_URL}examples/`}>
            View examples
          </a>
        </div>
        <div class="hero-metrics" aria-label="Composite visualization workflow">
          <span>Define charts</span>
          <span>Express relationships</span>
          <span>Automatic layout</span>
          <span>Optional overrides</span>
        </div>
      </div>
      <div class="composition-diagram" aria-label="Composite visualization structure">
        <div class="diagram-node diagram-node--wide">top bar chart</div>
        <div class="diagram-row">
          <div class="diagram-node">set size bars</div>
          <div class="diagram-node diagram-node--strong">matrix</div>
          <div class="diagram-node">box plot</div>
        </div>
        <div class="diagram-row diagram-row--small">
          <div class="diagram-node">pie</div>
          <div class="diagram-node">pie</div>
          <div class="diagram-node">pie</div>
          <div class="diagram-node">pie</div>
        </div>
      </div>
    </div>
  </section>

  <SectionShell title="From chart intent to a complete view">
    <div class="split-section">
      <div>
        <p class="section-lead">
          Start with data and visual encodings, then describe relationships with
          operations such as <code>stackY()</code> and <code>repeatX()</code>.
          The library handles chart rendering, measurement, and final placement.
        </p>
        <div class="feature-list">
          <span>Define individual charts</span>
          <span>Express abstract relationships</span>
          <span>Render with automatic layout</span>
        </div>
      </div>
      <CodePanel label={quickStartCode} />
    </div>
  </SectionShell>

  <SectionShell title="Why composite.js">
    <div class="feature-grid">
      <article class="feature-card">
        <h3>Focus on relationships</h3>
        <p>Think in charts, stacks, overlays, repetitions, alignments, and embeddings.</p>
      </article>
      <article class="feature-card">
        <h3>Concrete layout handled</h3>
        <p>Built-in renderers and the layout engine measure and position the view.</p>
      </article>
      <article class="feature-card">
        <h3>Control when needed</h3>
        <p>Start with defaults, then override sizes, spacing, or alignment deliberately.</p>
      </article>
    </div>
  </SectionShell>

  <SectionShell title="Featured examples">
    <ExampleGrid examples={featuredExamples} />
  </SectionShell>

  <SectionShell title="Documentation">
    <div class="docs-entry-grid">
      <a class="docs-entry" href={`${import.meta.env.BASE_URL}docs/concepts/`}>
        <span>Core concepts</span>
        <small>Charts, abstract relationships, automatic layout, and recursive composition.</small>
      </a>
      <a class="docs-entry" href={`${import.meta.env.BASE_URL}docs/api/`}>
        <span>Composition API</span>
        <small>chart, stackX, stackY, overlay, repeatX, repeatY, repeat, and embed.</small>
      </a>
      <a class="docs-entry" href={`${import.meta.env.BASE_URL}docs/marks/`}>
        <span>Marks</span>
        <small>Supported chart marks and their encoding patterns.</small>
      </a>
    </div>
  </SectionShell>
</SiteLayout>
