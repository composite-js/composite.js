---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SectionShell from "../../components/SectionShell.astro";
import CodePanel from "../../components/CodePanel.astro";
import { examples } from "../../data/examples.js";

export function getStaticPaths() {
  return examples.map((example) => ({
    params: { slug: example.slug },
    props: { example },
  }));
}

const { example } = Astro.props;
const base = import.meta.env.BASE_URL;
const imageSrc = example.image
  ? `${base}${example.image.replace(/^\//, "")}`
  : undefined;
const sourcePath = `examples/${example.source || example.slug}.js`;
---

<SiteLayout title={`${example.title} | composite.js`}>
  <SectionShell title={example.title}>
    {
      imageSrc && (
        <div class="example-detail-preview">
          <img src={imageSrc} alt="" />
        </div>
      )
    }
  </SectionShell>
  <SectionShell title="Example metadata">
    <div class="feature-card">
      <p>{example.summary}</p>
      <div class="tag-list">
        {example.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </div>
  </SectionShell>
  <SectionShell title="Example source">
    <CodePanel label={sourcePath} />
  </SectionShell>
</SiteLayout>
