---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SectionShell from "../../components/SectionShell.astro";
import ExampleEditor from "../../components/ExampleEditor.astro";
import { examples } from "../../data/examples.js";
import { getExampleSnippet } from "../../data/example-snippets.js";

export function getStaticPaths() {
  return examples.map((example) => ({
    params: { slug: example.slug },
    props: { example },
  }));
}

const { example } = Astro.props;
const base = import.meta.env.BASE_URL;
const snippet = getExampleSnippet(example);
const runnerSrc = `${base}examples/editor-runner/`;
---

<SiteLayout title={`${example.title} | composite.js`}>
  <SectionShell title={example.title}>
    <ExampleEditor example={example} snippet={snippet} runnerSrc={runnerSrc} />
  </SectionShell>
  <SectionShell title="Example metadata">
    <div class="feature-card">
      <p>{example.summary}</p>
      <div class="tag-list">
        {example.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </div>
  </SectionShell>
</SiteLayout>
