<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Example runner</title>
    <style>
      :root {
        color-scheme: light;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
        background: #ffffff;
        color: #172033;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: #ffffff;
      }

      #viewport {
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        background: #ffffff;
        cursor: grab;
        touch-action: none;
        user-select: none;
      }

      #viewport.is-panning {
        cursor: grabbing;
      }

      #app {
        min-width: max-content;
        padding: 16px;
        transform-origin: 0 0;
        width: max-content;
        will-change: transform;
      }
    </style>
  </head>
  <body>
    <div id="viewport">
      <div id="app"></div>
    </div>
    <script src="../../scripts/example-runner.js"></script>
  </body>
</html>
