<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Example preview runner</title>
    <style>
      :root {
        color-scheme: light;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
        background: #ffffff;
        color: #172033;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        overflow: hidden;
        background: #ffffff;
      }

      #viewport {
        position: relative;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        background: #ffffff;
      }

      #app {
        position: absolute;
        top: 0;
        left: 0;
        width: max-content;
        min-width: max-content;
        transform-origin: 0 0;
        will-change: transform;
      }

      #status {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        margin: 0;
        padding: 12px;
        color: #64748b;
        font-size: 0.78rem;
        line-height: 1.4;
        text-align: center;
      }

      #status[hidden] {
        display: none;
      }
    </style>
  </head>
  <body>
    <div id="viewport">
      <div id="app"></div>
      <p id="status" hidden></p>
    </div>
    <script src="../../scripts/example-preview-runner.js"></script>
  </body>
</html>
