---
import DocsLayout from "../../layouts/DocsLayout.astro";

const chartShapeLabel = "chart({ mark, data, encoding, ...options })";

const chartShapeCode = `chart({
  mark: "bar",
  data,
  encoding: { x: "category", y: "value" },
  width: 360,
  height: 240,
});`;

const markStyleCode = `chart({
  mark: "bar",
  data,
  encoding: { x: "category", y: "value" },
  markStyle: "rounded",
});

chart({
  mark: "scatter",
  data,
  encoding: { x: "score", y: "cost" },
  markStyle: "sketch",
});

chart({
  mark: "bar",
  data,
  encoding: { x: "category", y: "value" },
  markStyle: {
    rect(context) {
      return context.container
        .append("rect")
        .attr("x", context.left)
        .attr("y", context.top)
        .attr("width", context.width)
        .attr("height", context.height);
    },
  },
});`;

const markSections = [
  {
    id: "bar",
    summary: "Single-series bar chart.",
    required: ["x", "y"],
    optional: ["xDomain", "yDomain"],
    options: [
      "color",
      "showLabels",
      "padding",
      "axis visibility, names, and positions",
    ],
    example: `chart({
  mark: "bar",
  data: sales,
  encoding: { x: "category", y: "value" },
  color: "steelblue",
});`,
  },
  {
    id: "lollipop",
    summary: "Category values shown as stems ending in dots.",
    required: ["x", "y"],
    optional: ["xDomain", "yDomain"],
    options: ["color", "radius", "strokeWidth", "padding", "axis options"],
    example: `chart({
  mark: "lollipop",
  data: sales,
  encoding: { x: "category", y: "value" },
  radius: 5,
});`,
  },
  {
    id: "groupbar",
    summary: "Grouped bars for comparing series inside each category.",
    required: ["x", "y", "group"],
    optional: ["xDomain", "yDomain", "groupDomain"],
    options: [
      "colorScheme",
      "showLabels",
      "padding, including groupInner",
      "axis visibility, names, and positions",
    ],
    example: `chart({
  mark: "groupbar",
  data: rows,
  encoding: { x: "quarter", y: "count", group: "series" },
  colorScheme: ["#2563eb", "#f97316"],
});`,
  },
  {
    id: "stackbar",
    summary: "Stacked bars for totals split by a grouped series.",
    required: ["x", "y", "group"],
    optional: ["xDomain", "yDomain", "groupDomain"],
    options: [
      "colorScheme",
      "showLabels",
      "padding",
      "axis visibility, names, and positions",
    ],
    example: `chart({
  mark: "stackbar",
  data: rows,
  encoding: { x: "quarter", y: "count", group: "segment" },
  showLabels: true,
});`,
    note: "Within each category, values may be positive or negative, with zero allowed in either case. Mixing positive and negative values or repeating a group key is invalid. The automatic value domain includes zero.",
  },
  {
    id: "area",
    summary: "Filled area chart for continuous x/y data.",
    required: ["x", "y"],
    optional: ["xDomain", "yDomain"],
    options: ["color", "fillOpacity", "strokeWidth", "showPoints"],
    example: `chart({
  mark: "area",
  data: timeline,
  encoding: { x: "year", y: "rate" },
  fillOpacity: 0.3,
});`,
  },
  {
    id: "line",
    summary: "Single- or multi-series line chart with continuous or categorical x values.",
    required: ["x", "y"],
    optional: ["xDomain", "yDomain", "group", "groupDomain"],
    options: [
      "color or colorScheme",
      "showPoints, pointRadius, and strokeWidth",
      "curve: linear, step, or spline",
      "padding for categorical x values",
      "axis visibility, names, positions, tick formatting, and grid lines",
    ],
    example: `chart({
  mark: "line",
  data: timeline,
  encoding: { x: "quarter", y: "value", group: "series" },
  colorScheme: ["#b06e50", "#a5b65e"],
});`,
    note: 'Set curve to "step" for a step line or "spline" for a smooth line. The default is "linear".',
  },
  {
    id: "histogram",
    summary: "Counts raw numeric observations in equal-width bins.",
    required: ["x"],
    optional: ["xDomain", "yDomain"],
    options: ["binCount", "color", "axis options"],
    example: `chart({
  mark: "histogram",
  data: samples,
  encoding: { x: "measurement" },
  binCount: 12,
});`,
  },
  {
    id: "heatmap",
    summary: "Rectangular cells colored by a numeric value.",
    required: ["x", "group", "y"],
    optional: ["xDomain", "groupDomain", "yDomain"],
    options: ["color", "padding", "axis options"],
    example: `chart({
  mark: "heatmap",
  data: cells,
  encoding: { x: "column", group: "row", y: "value" },
  color: "#2166ac",
});`,
    note: "Use one row per cell. yDomain sets the color range; missing cells stay empty.",
  },
  {
    id: "waffle",
    summary: "Part-to-whole values shown as 100 colored cells.",
    required: ["x", "y"],
    optional: ["xDomain"],
    options: ["colorScheme"],
    example: `chart({
  mark: "waffle",
  data: shares,
  encoding: { x: "category", y: "value" },
});`,
    note: "Values must be non-negative and sum to more than zero. Shares are rounded to whole cells.",
  },
  {
    id: "candlestick",
    summary: "Open-high-low-close candles across an ordered x domain.",
    required: ["x", "open", "high", "low", "close"],
    optional: ["xDomain", "yDomain"],
    options: [
      "upColor and downColor",
      "candleWidth or candleWidthRatio",
      "wickWidth",
      "padding for categorical x values",
      "axis visibility, names, positions, tick formatting, and grid lines",
    ],
    example: `chart({
  mark: "candlestick",
  data: prices,
  encoding: {
    x: "date",
    open: "open",
    high: "high",
    low: "low",
    close: "close",
  },
});`,
    note: "High must be at least the open and close; low must be at most the open and close.",
  },
  {
    id: "scatter",
    summary: "Scatter plot for numeric x/y points.",
    required: ["x", "y"],
    optional: ["xDomain", "yDomain"],
    options: ["color", "radius", "axis visibility, names, and positions"],
    example: `chart({
  mark: "scatter",
  data: points,
  encoding: { x: "score", y: "cost" },
  radius: 5,
});`,
  },
  {
    id: "bubble",
    summary: "Bubble chart with optional radius encoding.",
    required: ["x", "y"],
    optional: ["size", "xDomain", "yDomain"],
    options: ["color", "maxRadius", "padding", "axis visibility, names, and positions"],
    example: `chart({
  mark: "bubble",
  data: points,
  encoding: { x: "region", y: "group", size: "population" },
  maxRadius: 18,
});`,
  },
  {
    id: "box",
    summary: "Box plot grouped by one categorical channel.",
    required: ["x", "y"],
    optional: ["xDomain", "yDomain"],
    options: [
      "color",
      "boxWidth",
      "whiskerStrokeDasharray",
      "valueRangePadding",
      "outlierFill and outlierOpacity",
      "padding",
    ],
    example: `chart({
  mark: "box",
  data: samples,
  encoding: { x: "group", y: "value" },
  boxWidth: 0.55,
});`,
  },
  {
    id: "dumbbell",
    summary: "Paired value comparison for each category.",
    required: ["x", "y"],
    optional: ["xDomain", "yDomain"],
    options: [
      "colors or colorScheme",
      "lineColor",
      "lineWidth",
      "radius",
      "padding",
    ],
    example: `chart({
  mark: "dumbbell",
  data: pairedRows,
  encoding: { x: "value", y: "category" },
  colors: ["#2563eb", "#ef4444"],
});`,
    note: "Each category must have exactly two rows.",
  },
  {
    id: "matrix",
    summary: "Long-form matrix cells for set membership or scalar intensity.",
    required: ["x", "group", "y"],
    optional: ["xDomain", "groupDomain"],
    options: [
      "color",
      "showXAxis and showYAxis",
      "xAxisPos and yAxisPos",
      "labelFontSize",
      "circleRadius",
      "stripe",
      "padding",
    ],
    example: `chart({
  mark: "matrix",
  data: cells,
  encoding: { x: "item", group: "set", y: "active" },
  showYAxis: true,
});`,
    note: "Use long-cell data. The y field should contain booleans or numbers from 0 to 1.",
  },
  {
    id: "pie",
    summary: "Pie or donut chart for part-to-whole data.",
    required: ["x", "y"],
    optional: ["xDomain"],
    options: ["colorScheme", "showLabels", "innerRadius"],
    example: `chart({
  mark: "pie",
  data: shares,
  encoding: { x: "category", y: "value" },
  innerRadius: 36,
});`,
  },
  {
    id: "pac",
    summary: "Proportional area chart using circles or squares.",
    required: ["x", "y"],
    optional: ["xDomain", "yDomain"],
    options: [
      "shape: circle or square",
      "color, colors, or colorScheme",
      "opacity",
      "padding",
      "axis visibility",
    ],
    example: `chart({
  mark: "pac",
  data: totals,
  encoding: { x: "count", y: "category" },
  shape: "square",
});`,
  },
  {
    id: "flow",
    summary: "Flow diagram connecting x categories to group categories.",
    required: ["x", "group", "y"],
    optional: ["xDomain", "yDomain", "groupDomain"],
    options: [
      "direction: horizontal or vertical",
      "color or colors",
      "colorBy: x or group",
      "opacity",
      "showLabels, showXLabels, and showGroupLabels",
      "xLabelName and groupLabelName",
      "labelFill, labelFontSize, and labelPadding",
      "minStrokeWidth and maxStrokeWidth",
    ],
    example: `chart({
  mark: "flow",
  data: links,
  encoding: { x: "origin", group: "destination", y: "count" },
  colorBy: "group",
});`,
  },
  {
    id: "stream",
    summary: "Stream graph for grouped values across an ordered x domain.",
    required: ["x", "y", "group"],
    optional: ["xDomain", "yDomain", "groupDomain"],
    options: [
      "colorScheme or colors",
      "opacity",
      "curve",
      "direction: horizontal or vertical",
      "axis visibility",
    ],
    example: `chart({
  mark: "stream",
  data: rows,
  encoding: { x: "week", y: "value", group: "topic" },
  opacity: 0.8,
});`,
  },
];

const formatFields = (fields) => fields.join(", ");
---

<DocsLayout title="Marks API | composite.js">
  <div class="docs-content">
    <header class="docs-hero">
      <p class="eyebrow">Marks API</p>
      <h1>Chart marks</h1>
      <p>
        A mark is the rendering layer inside a chart leaf. Create one with
        <code>{chartShapeLabel}</code>, then pass the chart node into layout
        operators such as <code>stackX</code>, <code>stackY</code>, <code>overlay</code>,
        <code>repeatX</code>, or <code>embed</code>.
      </p>
      <pre class="docs-code"><code>{chartShapeCode}</code></pre>
    </header>

    <section class="docs-section">
      <h2>Encoding channels</h2>
      <p>
        Encoding keys describe visual channels. Use <code>x</code>,
        <code>y</code>, <code>group</code>, and <code>size</code> as channel
        keys. Domain overrides live beside those channels as <code>xDomain</code>,
        <code>yDomain</code>, and <code>groupDomain</code>.
      </p>
      <p>
        Channel values are data field names, so the field names in your rows can
        be descriptive names from your dataset. For example,
        <code>{'encoding: { x: "category", y: "value" }'}</code> maps the data fields
        named <code>category</code> and <code>value</code> onto the <code>x</code>
        and <code>y</code> channels.
      </p>
      <p>
        Candlestick charts use <code>open</code>, <code>high</code>, <code>low</code>,
        and <code>close</code> for their four quantitative price fields.
      </p>
      <p>
        Every chart requires at least one data row. Quantitative fields must
        contain finite JavaScript numbers; numeric strings are not coerced.
        Negative values are supported for bar and grouped bar values, vertical
        lollipop y values, scatter x/y, numeric bubble x/y, the dumbbell value
        channel, stacked bar values, numeric candlestick x and OHLC fields,
        numeric line x/y, area x/y, histogram observations, and heatmap color
        values. Automatic value domains for bars, grouped bars, stacked bars,
        lollipops, lines, and areas include zero. Their default x-axis crosses
        vertical value scales at y=0, and horizontal value scales show a zero
        line. Category ticks and labels for bars, grouped bars, stacked bars,
        and lollipops sit on the unoccupied side of the zero baseline; grouped
        categories with both signs place their labels outside the plot.
        Explicit domain and axis-position overrides are preserved. Within a
        stacked bar category, values may be positive or
        negative but cannot mix signs; zero is allowed in either case. Other
        quantitative fields remain non-negative, including bubble size.
      </p>
      <p>
        Bars, grouped bars, stacked bars, box plots, dumbbells, and proportional
        area charts infer their orientation from <code>x</code> and <code>y</code>.
        Exactly one of those channels must contain numbers. Put the numeric field
        on <code>x</code> for a horizontal value channel, or on <code>y</code> for
        a vertical value channel. If a categorical value is numeric, store it as a
        string. <code>flow</code> and <code>stream</code> still use
        <code>direction</code> for layout orientation.
      </p>
    </section>

    <section class="docs-section">
      <h2>Supported marks</h2>
      <div class="docs-table-wrap">
        <table class="api-table">
          <thead>
            <tr>
              <th>Mark</th>
              <th>Required encoding</th>
              <th>Optional encoding</th>
              <th>Use</th>
            </tr>
          </thead>
          <tbody>
            {
              markSections.map((mark) => (
                <tr>
                  <td>
                    <a href={`#${mark.id}`}>
                      <code>{mark.id}</code>
                    </a>
                  </td>
                  <td>{formatFields(mark.required)}</td>
                  <td>{formatFields(mark.optional)}</td>
                  <td>{mark.summary}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="docs-section">
      <h2>Common chart options</h2>
      <dl class="api-list">
        <div>
          <dt><code>mark</code></dt>
          <dd>One of the supported mark names listed below. Defaults to <code>bar</code>.</dd>
        </div>
        <div>
          <dt><code>data</code></dt>
          <dd>
            A non-empty array of row objects used by the encoded data fields.
            Quantitative values must be finite; support for negative values depends on the mark and channel.
          </dd>
        </div>
        <div>
          <dt><code>encoding</code></dt>
          <dd>An object mapping visual channels to data field names and optional domains.</dd>
        </div>
        <div>
          <dt><code>width</code>, <code>height</code>, <code>margin</code></dt>
          <dd>
            Finite, non-negative content dimensions and margins for the chart leaf.
          </dd>
        </div>
        <div>
          <dt><code>padding</code></dt>
          <dd>
            Band padding for categorical scales. Use <code>inner</code> and
            <code>outer</code>, or axis-specific <code>xInner</code>,
            <code>xOuter</code>, <code>yInner</code>, and <code>yOuter</code>.
            Padding values must be finite and non-negative.
          </dd>
        </div>
        <div>
          <dt>Axes</dt>
          <dd>
            Marks with axes can use <code>showXAxis</code>, <code>showYAxis</code>,
            <code>xAxisName</code>, <code>yAxisName</code>, <code>xAxisPos</code>,
            and <code>yAxisPos</code>.
          </dd>
        </div>
        <div>
          <dt><code>markStyle</code></dt>
          <dd>
            Shape styling for supported rect, circle, and sector marks. Use
            <code>"rounded"</code>, Rough.js-backed <code>"sketch"</code>, or
            provide custom primitive renderers such as <code>rect(context)</code>,
            <code>circle(context)</code>, and <code>sector(context)</code>.
          </dd>
        </div>
      </dl>
      <pre class="docs-code"><code>{markStyleCode}</code></pre>
    </section>

    <section class="docs-section mark-grid" aria-label="Mark reference">
      {
        markSections.map((mark) => (
          <article class="mark-reference" id={mark.id}>
            <div class="mark-reference__header">
              <h2>
                <code>{mark.id}</code>
              </h2>
              <p>{mark.summary}</p>
            </div>
            <dl class="api-list api-list--compact">
              <div>
                <dt>Required encoding</dt>
                <dd>{formatFields(mark.required)}</dd>
              </div>
              <div>
                <dt>Optional encoding</dt>
                <dd>{formatFields(mark.optional)}</dd>
              </div>
              <div>
                <dt>Common options</dt>
                <dd>{mark.options.join("; ")}</dd>
              </div>
              {mark.note && (
                <div>
                  <dt>Data note</dt>
                  <dd>{mark.note}</dd>
                </div>
              )}
            </dl>
            <pre class="docs-code"><code>{mark.example}</code></pre>
          </article>
        ))
      }
    </section>
  </div>
</DocsLayout>
