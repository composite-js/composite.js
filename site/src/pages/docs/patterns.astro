---
import DocsLayout from "../../layouts/DocsLayout.astro";

const recipes = [
  {
    title: "Place an overview above details",
    description:
      "Express a top-to-bottom relationship with stackY; the layout engine calculates the concrete positions.",
    code: `const view = stackY([topBars, matrix, pieRow]);`,
  },
  {
    title: "Align through a shared component",
    description:
      "Add an explicit alignment target only when one view should line up with a component nested inside another view.",
    code: `const body = stackX([leftBars, matrix, detailChart]);

const view = stackY([topBars, body], {
  align: [matrix, matrix],
});`,
  },
  {
    title: "Repeat one view across categories",
    description:
      "Use repeatX or repeatY when each domain value produces the same kind of child view.",
    code: `const pies = repeatX(ids, (id) =>
  chart({
    mark: "pie",
    data: detailById[id],
    encoding: { x: "category", y: "value" },
  }),
);`,
  },
  {
    title: "Place views in a semantic structure",
    description:
      "Use repeat with embed when children should be placed into slots from a container.",
    code: `const repeated = repeat(events, (event) =>
  chart({
    mark: "bubble",
    data: event.points,
    encoding: { x: "x", y: "y", size: "size" },
  }),
);

const sequence = embed(
  sequenceContainer({ xDomain: weeks, yDomain: learners }),
  repeated,
  { x: "week", y: "learner", key: "id" },
);`,
  },
  {
    title: "Annotations",
    description:
      "Use text nodes for labels that need to participate in the same layout as charts.",
    code: `const heading = text({
  text: "Completion by cohort",
  width: 180,
  height: 24,
  fontWeight: 700,
});

const view = stackY([heading, bars]);`,
  },
  {
    title: "Framed groups",
    description:
      "Wrap any node with frame when a composed region needs visual grouping or emphasis.",
    code: `const framedMatrix = frame(matrix, {
  padding: 8,
  stroke: "#94a3b8",
  strokeDasharray: "4 3",
});`,
  },
];
---

<DocsLayout title="Composition Patterns | composite.js">
  <div class="docs-content">
    <header class="docs-hero">
      <p class="eyebrow">Patterns</p>
      <h1>Turn chart relationships into code</h1>
      <p>
        Start from the relationship you want to express, then choose the
        corresponding composition operator. Each recipe begins with defaults;
        explicit layout options appear only when the relationship requires
        additional information.
      </p>
    </header>

    <section class="docs-section mark-grid" aria-label="Composition recipes">
      {
        recipes.map((recipe) => (
          <article class="mark-reference">
            <div class="mark-reference__header">
              <h2>{recipe.title}</h2>
              <p>{recipe.description}</p>
            </div>
            <pre class="docs-code"><code>{recipe.code}</code></pre>
          </article>
        ))
      }
    </section>
  </div>
</DocsLayout>
