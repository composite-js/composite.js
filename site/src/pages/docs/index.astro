---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { docsCards } from "../../data/docs.js";

const base = import.meta.env.BASE_URL;
const hrefFor = (href) => `${base}${href.replace(/^\//, "")}`;

const layoutNodeCode = `import { chart, stackY } from "composite-js";

const top = chart({
  mark: "bar",
  data,
  encoding: { x: "category", y: "value" },
});

const matrix = chart({
  mark: "matrix",
  data: cells,
  encoding: { x: "item", group: "set", y: "active" },
});

const view = stackY([top, matrix]);
view.render(document.querySelector("#app"));`;
---

<DocsLayout title="Documentation | composite.js">
  <div class="docs-content">
    <header class="docs-hero">
      <p class="eyebrow">Documentation</p>
      <h1>Describe charts and how they relate</h1>
      <p>
        You define individual charts and express abstract relationships through
        stacking, repetition, alignment, and embedding. composite.js renders
        the charts, measures their content, and computes the concrete layout.
      </p>
      <pre class="docs-code"><code>{layoutNodeCode}</code></pre>
    </header>

    <section class="docs-section">
      <h2>Recommended path</h2>
      <p>
        Start by defining and composing charts with the default layout behavior.
        Then learn the underlying layout-node model and optional controls before
        using the complete API and marks reference.
      </p>
      <div class="docs-entry-grid">
        {
          docsCards.map((item) => (
            <a class="docs-entry" href={hrefFor(item.href)}>
              <span>{item.label}</span>
              <small>{item.summary}</small>
            </a>
          ))
        }
      </div>
    </section>

    <section class="docs-section">
      <h2>Responsibility at a glance</h2>
      <dl class="api-list">
        <div>
          <dt>You describe the charts</dt>
          <dd>
            Provide data, a mark type, and visual encodings for each component.
          </dd>
        </div>
        <div>
          <dt>You describe the relationships</dt>
          <dd>
            State whether components stack, repeat, align, or embed without
            calculating pixel coordinates.
          </dd>
        </div>
        <div>
          <dt>composite.js handles the concrete layout</dt>
          <dd>
            Built-in defaults, renderers, measurement, and positioning turn the
            description into a coordinated browser visualization.
          </dd>
        </div>
      </dl>
    </section>
  </div>
</DocsLayout>
