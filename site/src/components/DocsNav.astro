---
import { docsNavItems } from "../data/docs.js";

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const hrefFor = (href) => `${base}${href.replace(/^\//, "")}`;
---

<nav class="docs-nav" aria-label="Documentation navigation">
  {
    docsNavItems.map((item) => {
      const href = hrefFor(item.href);
      const isCurrent = currentPath === href;
      const showChildren = isCurrent && item.children?.length;
      return (
        <div class="docs-nav__group">
          <a href={href} aria-current={isCurrent ? "page" : undefined}>
            {item.label}
          </a>
          {showChildren && (
            <div class="docs-nav__children" aria-label={`${item.label} sections`}>
              {item.children.map((child) => (
                <a href={hrefFor(child.href)}>{child.label}</a>
              ))}
            </div>
          )}
        </div>
      );
    })
  }
</nav>
