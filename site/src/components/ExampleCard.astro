---
const { example } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}examples/${example.slug}/`;
const imageSrc = example.image
  ? `${base}${example.image.replace(/^\//, "")}`
  : undefined;
const previewLabel = example.tags.join(" + ");
---

<a class="example-card" href={href}>
  <div class="example-card__preview" aria-label={`${example.title} preview`}>
    {
      imageSrc ? (
        <img src={imageSrc} alt="" loading="lazy" />
      ) : (
        <span>{previewLabel}</span>
      )
    }
  </div>
  <h3 class="example-card__title">{example.title}</h3>
  {example.summary && <p class="example-card__summary">{example.summary}</p>}
  <div class="tag-list">
    {example.tags.map((tag) => <span class="tag">{tag}</span>)}
  </div>
</a>
