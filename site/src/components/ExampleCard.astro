---
const { example } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}examples/${example.slug}/`;
const previewSrc = `${base}examples/preview-runner/?example=${encodeURIComponent(
  example.slug,
)}`;
---

<article class="example-card">
  <div class="example-card__preview" aria-label={`${example.title} preview`}>
    <iframe
      src={previewSrc}
      title={`${example.title} live preview`}
      loading="lazy"
      sandbox="allow-scripts allow-same-origin"></iframe>
  </div>
  <h3 class="example-card__title">
    <a class="example-card__link" href={href}>{example.title}</a>
  </h3>
  {example.summary && <p class="example-card__summary">{example.summary}</p>}
  <div class="tag-list">
    {example.tags.map((tag) => <span class="tag">{tag}</span>)}
  </div>
</article>
