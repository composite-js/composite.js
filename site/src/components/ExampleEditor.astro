---
const { example, snippet, runnerSrc } = Astro.props;
---

<div class="example-editor" data-example-editor>
  <div class="example-editor__toolbar">
    <span class="example-editor__label">{example.title}</span>
    <div class="example-editor__actions">
      <button class="example-editor__button" type="button" data-editor-run>
        Run
      </button>
      <button class="example-editor__button" type="button" data-editor-reset>
        Reset
      </button>
    </div>
    <span class="example-editor__status" data-editor-status>Loading</span>
  </div>
  <div class="example-editor__workspace">
    <iframe
      class="example-editor__preview"
      title={`${example.title} rendered preview`}
      src={runnerSrc}
      sandbox="allow-scripts allow-same-origin"
      data-editor-preview></iframe>
    <textarea
      class="example-editor__code"
      spellcheck="false"
      data-editor-code>{snippet}</textarea>
  </div>
  <pre class="example-editor__error" data-editor-error hidden></pre>
</div>

<script>
  const editorMessageSource = "composite-example-editor";
  const runnerMessageSource = "composite-example-runner";
  const debounceMs = 450;
  let codeMirrorModulesPromise;

  function loadCodeMirrorModules() {
    if (!codeMirrorModulesPromise) {
      codeMirrorModulesPromise = Promise.all([
        import("codemirror"),
        import("@codemirror/commands"),
        import("@codemirror/lang-javascript"),
        import("@codemirror/view"),
      ]).then(([codemirrorModule, commandsModule, javascriptModule, viewModule]) => ({
        basicSetup: codemirrorModule.basicSetup,
        EditorView: codemirrorModule.EditorView,
        indentWithTab: commandsModule.indentWithTab,
        javascript: javascriptModule.javascript,
        keymap: viewModule.keymap,
      }));
    }

    return codeMirrorModulesPromise;
  }

  function createEditorTheme(EditorView) {
    return EditorView.theme(
      {
        "&": {
          backgroundColor: "#ffffff",
          color: "#172033",
          fontSize: "0.86rem",
          height: "360px",
        },
        ".cm-scroller": {
          fontFamily:
            '"SFMono-Regular", Consolas, "Liberation Mono", Menlo, ui-monospace, monospace',
          lineHeight: "1.55",
        },
        ".cm-content": {
          padding: "16px 0",
        },
        ".cm-line": {
          padding: "0 16px",
        },
        ".cm-gutters": {
          backgroundColor: "#f8fafc",
          borderRightColor: "#d8dee9",
          color: "#64748b",
        },
        ".cm-activeLine": {
          backgroundColor: "#eff6ff",
        },
        ".cm-activeLineGutter": {
          backgroundColor: "#eff6ff",
        },
        "&.cm-focused": {
          outline: "2px solid #2563eb",
          outlineOffset: "-2px",
        },
      },
      { dark: false },
    );
  }

  async function createCodeEditor(textarea, onChange) {
    const { basicSetup, EditorView, indentWithTab, javascript, keymap } =
      await loadCodeMirrorModules();
    const editorTheme = createEditorTheme(EditorView);
    const editorHost = document.createElement("div");
    editorHost.className = "example-editor__cm";
    textarea.after(editorHost);
    textarea.hidden = true;
    textarea.setAttribute("aria-hidden", "true");

    return new EditorView({
      doc: textarea.value,
      parent: editorHost,
      extensions: [
        basicSetup,
        javascript(),
        keymap.of([indentWithTab]),
        editorTheme,
        EditorView.updateListener.of((update) => {
          if (!update.docChanged) return;

          textarea.value = update.state.doc.toString();
          onChange();
        }),
      ],
    });
  }

  async function initializeExampleEditor(editor) {
    if (editor.dataset.editorReady === "true") return;

    const code = editor.querySelector("[data-editor-code]");
    const iframe = editor.querySelector("[data-editor-preview]");
    const runButton = editor.querySelector("[data-editor-run]");
    const resetButton = editor.querySelector("[data-editor-reset]");
    const status = editor.querySelector("[data-editor-status]");
    const errorOutput = editor.querySelector("[data-editor-error]");
    const initialSnippet = code.value;
    let debounceId;
    let suppressEditorChange = false;
    const editorView = await createCodeEditor(code, () => {
      if (!suppressEditorChange) scheduleRun();
    });

    editor.dataset.editorReady = "true";

    function getSnippet() {
      return editorView.state.doc.toString();
    }

    function replaceSnippet(snippet) {
      suppressEditorChange = true;

      try {
        editorView.dispatch({
          changes: {
            from: 0,
            to: editorView.state.doc.length,
            insert: snippet,
          },
        });
      } finally {
        suppressEditorChange = false;
      }

      code.value = snippet;
    }

    function setStatus(state, message) {
      editor.dataset.editorState = state;
      status.textContent = message;
    }

    function clearError() {
      errorOutput.hidden = true;
      errorOutput.textContent = "";
    }

    function showError(message, stack) {
      errorOutput.hidden = false;
      errorOutput.textContent =
        stack && stack !== message ? `${message}\n\n${stack}` : message;
    }

    function sendRun() {
      if (!iframe.contentWindow) {
        setStatus("error", "Preview unavailable");
        return;
      }

      clearError();
      setStatus("running", "Running");
      iframe.contentWindow.postMessage(
        {
          source: editorMessageSource,
          type: "run",
          snippet: getSnippet(),
        },
        window.location.origin,
      );
    }

    function scheduleRun() {
      window.clearTimeout(debounceId);
      setStatus("pending", "Edited");
      debounceId = window.setTimeout(sendRun, debounceMs);
    }

    runButton.addEventListener("click", () => {
      window.clearTimeout(debounceId);
      sendRun();
    });

    resetButton.addEventListener("click", () => {
      replaceSnippet(initialSnippet);
      window.clearTimeout(debounceId);
      sendRun();
    });

    code.addEventListener("input", scheduleRun);

    window.addEventListener("message", (event) => {
      if (event.source !== iframe.contentWindow) return;
      if (event.origin !== window.location.origin) return;

      const message = event.data;
      if (!message || message.source !== runnerMessageSource) return;

      if (message.type === "ready") {
        sendRun();
        return;
      }

      if (message.type === "success") {
        clearError();
        setStatus("success", "Rendered");
        return;
      }

      if (message.type === "error") {
        setStatus("error", "Error");
        showError(message.message || "Unknown error", message.stack || "");
      }
    });
  }

  document
    .querySelectorAll("[data-example-editor]")
    .forEach((editor) => initializeExampleEditor(editor));
</script>
